{
  "name": "nuvro-api-studio",
  "private": true,
  "version": "0.1.0",
  "description": "NUVRO API Studio — open-source API development and testing platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @nuvro/database db:generate",
    "db:migrate": "pnpm --filter @nuvro/database db:migrate",
    "db:seed": "pnpm --filter @nuvro/database db:seed",
    "db:studio": "pnpm --filter @nuvro/database db:studio",
    "db:reset": "pnpm --filter @nuvro/database db:reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "esbuild"
    ]
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
