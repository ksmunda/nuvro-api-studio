FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

# Copy lockfile and all package.json files first to leverage Docker cache
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/config/package.json ./packages/config/
COPY packages/types/package.json ./packages/types/
COPY packages/validation/package.json ./packages/validation/
COPY packages/core/package.json ./packages/core/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/ui/package.json ./packages/ui/
COPY backend/api/package.json ./backend/api/
COPY database/prisma/package.json ./database/prisma/
COPY apps/web/package.json ./apps/web/
COPY tests/e2e/package.json ./tests/e2e/

RUN pnpm install --frozen-lockfile

# Copy the rest of the files and build
COPY . .
RUN pnpm --filter @nuvro/database db:generate
RUN pnpm --filter @nuvro/api build

EXPOSE 4000
CMD ["pnpm", "--filter", "@nuvro/api", "dev"]
