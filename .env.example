# ============================================
# NUVRO API Studio — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- Database ---
DATABASE_URL="postgresql://nuvro:nuvro_dev_password@localhost:5432/nuvro_dev"

# --- Backend API ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Authentication ---
JWT_SECRET=change_me_in_production_at_least_64_chars_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_in_production_different_from_jwt_secret_random
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_SECRET=change_me_in_production_session_signing_secret_at_least_32_chars
SESSION_EXPIRES_IN=604800
AUTH_COOKIE_NAME=sid
REQUEST_TIMEOUT_MS=30000
MAX_RESPONSE_SIZE_MB=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api
