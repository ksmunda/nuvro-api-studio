{
  "name": "@nuvro/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and database client for NUVRO API Studio",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "prisma migrate reset",
    "type-check": "tsc --noEmit",
    "build": "echo 'database package has no build step'"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@nuvro/config": "workspace:*",
    "@types/node": "^22.20.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
